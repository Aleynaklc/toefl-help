# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/toefl_vocab

# Anthropic API (quiz cümleleri, yazma geri bildirimi, çeviri)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
